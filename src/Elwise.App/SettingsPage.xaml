<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Elwise.App.ViewModels"
             x:Class="Elwise.App.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Prisområde" FontAttributes="Bold" />
        <Picker ItemsSource="{Binding Areas}" SelectedIndex="{Binding AreaIndex}" />

        <Label Text="Opvasken må køre" FontAttributes="Bold" Margin="0,12,0,0" />
        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
            <Label Text="Fra" VerticalOptions="Center" />
            <Picker Grid.Column="1" ItemsSource="{Binding FromHours}" SelectedIndex="{Binding FromHourIndex}" />
            <Label Grid.Column="2" Text="til" VerticalOptions="Center" />
            <Picker Grid.Column="3" ItemsSource="{Binding ToHours}" SelectedIndex="{Binding ToHourIndex}" />
        </Grid>

        <Label Text="Programmets længde" FontAttributes="Bold" Margin="0,12,0,0" />
        <Picker ItemsSource="{Binding Durations}" SelectedIndex="{Binding DurationIndex}" />

        <Label Text="Appen foreslår aldrig kl. 17–21." FontSize="13" Margin="0,12,0,0" />

    </VerticalStackLayout>

</ContentPage>