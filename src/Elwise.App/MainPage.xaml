<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Elwise.App.ViewModels"
             x:Class="Elwise.App.MainPage"
             x:DataType="vm:PricesViewModel">

    <Grid RowDefinitions="Auto,*" Padding="16,8">

        <Border Padding="16" Margin="0,0,0,8" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Billigste tid til opvasken" FontAttributes="Bold" />
                <Label Text="{Binding CheapestText}" FontSize="18" />
                <Button Text="Påmind mig, når det starter" Command="{Binding RemindCommand}" Margin="0,8,0,0" />
                <Label Text="{Binding ReminderText}" FontSize="13" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Days}" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:PriceGroup">
                    <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" Padding="0,16,0,8" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PriceRow">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                        <Label Text="{Binding Time}" />
                        <Label Grid.Column="1" Text="{Binding Price}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>