<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Elwise.App.ViewModels"
             x:Class="Elwise.App.MainPage"
             x:DataType="vm:PricesViewModel"
             Title="Elwise">

    <CollectionView ItemsSource="{Binding Days}" IsGrouped="True">

        <CollectionView.Header>
            <VerticalStackLayout Padding="24,8,24,0" Spacing="32">

                <!-- When to start -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Start opvasken" Style="{StaticResource MutedText}" FontSize="17" />
                    <Label Text="{Binding StartTimeText}"
                           FontFamily="TextBold"
                           FontSize="64"
                           Padding="8,0"
                           HorizontalOptions="Start"
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource Highlight}}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Highlight}, Dark={StaticResource PageBackgroundDark}}" />
                    <Label Text="{Binding StartWhenText}" FontSize="17" />
                    <Label Text="{Binding DetailText}" Style="{StaticResource MutedText}" FontSize="15" />
                    <Label Text="{Binding SavingsText}" IsVisible="{Binding HasSavings}" FontFamily="TextBold" FontSize="15" />
                    <Button Text="{Binding RemindButtonText}"
                            Command="{Binding RemindCommand}"
                            FontFamily="TextBold"
                            FontSize="16"
                            CornerRadius="12"
                            HeightRequest="52"
                            Margin="0,16,0,0" />
                    <Label Text="{Binding ReminderText}" Style="{StaticResource MutedText}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- The chart -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Prisen i dag og i morgen" Style="{StaticResource SectionTitle}" />
                    <GraphicsView x:Name="PriceChart" Drawable="{Binding Chart}" HeightRequest="180" />
                    <Label Text="Det gule felt er den billigste tid. Den lodrette streg er nu, og kl. 17–21 er nedtonet."
                           Style="{StaticResource MutedText}" />
                    <Label Text="{Binding PriceNoteText}" Style="{StaticResource MutedText}" FontSize="12" />
                </VerticalStackLayout>

                <Label Text="Alle priser" Style="{StaticResource SectionTitle}" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="vm:PriceGroup">
                <Label Text="{Binding Title}" FontFamily="TextBold" FontSize="15" Padding="24,20,24,8" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:PriceRow">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="24,10">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsInWindow}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource HighlightSoft}" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Label Text="{Binding Time}" />
                        <Label Grid.Column="1" Text="{Binding Price}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="24,0" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <ContentView HeightRequest="32" />
        </CollectionView.Footer>

    </CollectionView>

</ContentPage>