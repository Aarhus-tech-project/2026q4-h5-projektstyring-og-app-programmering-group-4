<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Elwise.App.ViewModels"
             x:Class="Elwise.App.MainPage"
             x:DataType="vm:PricesViewModel">

    <CollectionView ItemsSource="{Binding Prices}" Margin="16,8">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:PriceRow">
                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                    <Label Text="{Binding Time}" />
                    <Label Grid.Column="1" Text="{Binding Price}" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>